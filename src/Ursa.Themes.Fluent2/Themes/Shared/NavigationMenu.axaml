<ResourceDictionary x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="NavigationMenuItemExpandIconGlyph" ResourceKey="ComboBoxIcon" />


    <x:Double x:Key="NavigationMenuItemExpandIconWidth">8</x:Double>
    <x:Double x:Key="NavigationMenuItemExpandIconHeight">8</x:Double>

    <x:Double x:Key="NavigationMenuSeparatorHeaderFontSize">12</x:Double>
    <x:Double x:Key="NavigationMenuSeparatorBorderHeight">1</x:Double>



    <Thickness x:Key="NavigationMenuItemFlyoutMargin">8</Thickness>

    <Thickness x:Key="NavigationMenuSeparatorMargin">4,0</Thickness>
    <Thickness x:Key="NavigationMenuSeparatorHeaderMargin">4,0</Thickness>
    <Thickness x:Key="NavigationMenuSeparatorBorderMargin">0,2</Thickness>
</ResourceDictionary>
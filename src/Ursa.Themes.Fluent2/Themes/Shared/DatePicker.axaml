<ResourceDictionary x:ClassModifier="internal" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--CalendarDayButton-->
    <x:Double x:Key="CalendarDayMinWidth">40</x:Double>
    <x:Double x:Key="CalendarDayMinHeight">40</x:Double>
    <Thickness x:Key="CalendarDayMargin">1</Thickness>
    <Thickness x:Key="CalendarDayBorderThickness">1</Thickness>

    <CornerRadius x:Key="CalendarDayInRangeCornerRadius">0</CornerRadius>
    <Thickness x:Key="CalendarDayNoBorderThickness">0</Thickness>

    <CornerRadius x:Key="CalendarDayStartDateCornerRadius">20 0 0 20</CornerRadius>
    <CornerRadius x:Key="CalendarDayEndDateCornerRadius">0 20 20 0</CornerRadius>

    <!--CalendarYearButton-->
    <x:Double x:Key="CalendarYearMinWidth">32</x:Double>
    <x:Double x:Key="CalendarYearMinHeight">32</x:Double>
    <Thickness x:Key="CalendarYearMargin">0 2</Thickness>
    <Thickness x:Key="CalendarYearBorderThickness">1</Thickness>
    <Thickness x:Key="CalendarYearSelectedBorderThickness">0</Thickness>

    <!--CalendarView-->
    <x:Double x:Key="CalendarViewMinWidth">260</x:Double>
    <x:Double x:Key="CalendarViewMinHeight">260</x:Double>
    <x:Double x:Key="CalendarViewPathIconWidth">8</x:Double>
    <x:Double x:Key="CalendarViewPathIconHeight">8</x:Double>
</ResourceDictionary>

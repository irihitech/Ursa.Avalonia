<ResourceDictionary x:ClassModifier="internal" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="SkeletonStartAnimationBackground" StartPoint="0%,100%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#E6E6E6" />
        <GradientStop Offset="0" Color="#FAFAFA" />
        <GradientStop Offset="1" Color="#E6E6E6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SkeletonEndAnimationBackground" StartPoint="0%,100%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#E6E6E6" />
        <GradientStop Offset="1" Color="#FAFAFA" />
        <GradientStop Offset="1" Color="#E6E6E6" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SkeletonDefaultBackground" Color="#E6E6E6" />
</ResourceDictionary>
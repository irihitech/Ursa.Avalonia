<ResourceDictionary x:ClassModifier="internal" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="ClosableTagForeground" ResourceKey="TextFillColorPrimary" />
    <StaticResource x:Key="ClosableTagBackground" ResourceKey="SolidBackgroundFillColorSecondary" />
    <StaticResource x:Key="ClosableTagBorder" ResourceKey="ControlStrokeColorDefault" />
    <StaticResource x:Key="ClosableTagCloseButtonForeground" ResourceKey="TextFillColorTertiary" />
    <StaticResource x:Key="ClosableTagCloseButtonPointeroverForeground" ResourceKey="TextFillColorSecondary" />
    <StaticResource x:Key="ClosableTagCloseButtonPressedForeground" ResourceKey="TextFillColorPrimary" />
</ResourceDictionary>

<ResourceDictionary x:ClassModifier="internal" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="NotificationCardLightBackground" ResourceKey="SolidBackgroundFillColorBase" />
    <StaticResource x:Key="NotificationCardLightInformationBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="NotificationCardLightInformationBackground" ResourceKey="ControlFillColorSecondary" />
    <StaticResource x:Key="NotificationCardLightSuccessBorderBrush" ResourceKey="SystemFillColorSuccess" />
    <StaticResource x:Key="NotificationCardLightSuccessBackground" ResourceKey="SystemFillColorSuccessBackground" />
    <StaticResource x:Key="NotificationCardLightWarningBorderBrush" ResourceKey="SystemFillColorCaution" />
    <StaticResource x:Key="NotificationCardLightWarningBackground" ResourceKey="SystemFillColorCautionBackground" />
    <StaticResource x:Key="NotificationCardLightErrorBorderBrush" ResourceKey="SystemFillColorCritical" />
    <StaticResource x:Key="NotificationCardLightErrorBackground" ResourceKey="SystemFillColorCriticalBackground" />
    <StaticResource x:Key="NotificationCardCloseButtonForeground" ResourceKey="TextFillColorSecondary" />
</ResourceDictionary>

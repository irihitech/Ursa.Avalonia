<ResourceDictionary x:ClassModifier="internal" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="DualBadgeDefaultIconForeground" ResourceKey="TextOnAccentFillColorPrimary" />
    <StaticResource x:Key="DualBadgeDefaultHeaderForeground" ResourceKey="TextOnAccentFillColorPrimary" />
    <StaticResource x:Key="DualBadgeDefaultForeground" ResourceKey="TextOnAccentFillColorPrimary" />
    <LinearGradientBrush x:Key="DualBadgeDefaultHeaderBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{StaticResource ControlFillColorSecondary}" Offset="0" />
        <GradientStop Color="{StaticResource TextFillColorSecondary}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DualBadgeFlatRedBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{StaticResource SystemFillColorCriticalBackground}" Offset="0" />
        <GradientStop Color="{StaticResource SystemFillColorCritical}" Offset="1" />
    </LinearGradientBrush>

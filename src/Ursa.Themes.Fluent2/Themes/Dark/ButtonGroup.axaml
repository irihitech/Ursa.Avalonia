<ResourceDictionary x:ClassModifier="internal" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="ButtonGroupSeparatorForeground" ResourceKey="CardStrokeColorDefault" />
    <!--  Light  -->
    <StaticResource x:Key="ButtonGroupDefaultPrimaryForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
    <StaticResource x:Key="ButtonGroupDefaultSecondaryForeground" ResourceKey="TextFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupDefaultTertiaryForeground" ResourceKey="TextFillColorTertiary" />
    <StaticResource x:Key="ButtonGroupDefaultSuccessForeground" ResourceKey="SystemFillColorSuccess" />
    <StaticResource x:Key="ButtonGroupDefaultWarningForeground" ResourceKey="SystemFillColorCaution" />
    <StaticResource x:Key="ButtonGroupDefaultDangerForeground" ResourceKey="SystemFillColorCritical" />
    <StaticResource x:Key="ButtonGroupDefaultDisabledForeground" ResourceKey="TextFillColorDisabled" />
    <StaticResource x:Key="ButtonGroupDefaultBackground" ResourceKey="ControlFillColorDefault" />
    <StaticResource x:Key="ButtonGroupDefaultPointeroverBackground" ResourceKey="ControlFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupDefaultPressedBackground" ResourceKey="ControlFillColorTertiary" />
    <StaticResource x:Key="ButtonGroupDefaultDisabledBackground" ResourceKey="ControlFillColorDisabled" />
    <SolidColorBrush x:Key="ButtonGroupDefaultBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonGroupDefaultPointeroverBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonGroupDefaultPressedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonGroupDefaultDisabledBorderBrush" Color="Transparent" />
    <!--  end Light  -->
    <!--  Solid  -->
    <StaticResource x:Key="ButtonGroupSolidForeground" ResourceKey="TextOnAccentFillColorPrimary" />
    <StaticResource x:Key="ButtonGroupSolidPrimaryBackground" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="ButtonGroupSolidPrimaryPointeroverBackground" ResourceKey="AccentFillColorSecondaryBrush" />
    <StaticResource x:Key="ButtonGroupSolidPrimaryPressedBackground" ResourceKey="AccentFillColorTertiaryBrush" />
    <StaticResource x:Key="ButtonGroupSolidSecondaryBackground" ResourceKey="TextFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupSolidSecondaryPointeroverBackground" ResourceKey="ControlFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupSolidSecondaryPressedBackground" ResourceKey="TextFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupSolidTertiaryBackground" ResourceKey="TextFillColorTertiary" />
    <StaticResource x:Key="ButtonGroupSolidTertiaryPointeroverBackground" ResourceKey="ControlFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupSolidTertiaryPressedBackground" ResourceKey="TextFillColorTertiary" />
    <StaticResource x:Key="ButtonGroupSolidSuccessBackground" ResourceKey="SystemFillColorSuccess" />
    <StaticResource x:Key="ButtonGroupSolidSuccessPointeroverBackground" ResourceKey="SystemFillColorSuccess" />
    <StaticResource x:Key="ButtonGroupSolidSuccessPressedBackground" ResourceKey="SystemFillColorSuccess" />
    <StaticResource x:Key="ButtonGroupSolidWarningBackground" ResourceKey="SystemFillColorCaution" />
    <StaticResource x:Key="ButtonGroupSolidWarningPointeroverBackground" ResourceKey="SystemFillColorCaution" />
    <StaticResource x:Key="ButtonGroupSolidWarningPressedBackground" ResourceKey="SystemFillColorCaution" />
    <StaticResource x:Key="ButtonGroupSolidDangerBackground" ResourceKey="SystemFillColorCritical" />
    <StaticResource x:Key="ButtonGroupSolidDangerPointeroverBackground" ResourceKey="SystemFillColorCritical" />
    <StaticResource x:Key="ButtonGroupSolidDangerPressedBackground" ResourceKey="SystemFillColorCritical" />
    <StaticResource x:Key="ButtonGroupSolidPrimaryBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="ButtonGroupSolidPrimaryPointeroverBorderBrush" ResourceKey="AccentFillColorSecondaryBrush" />
    <StaticResource x:Key="ButtonGroupSolidPrimaryPressedBorderBrush" ResourceKey="AccentFillColorTertiaryBrush" />
    <StaticResource x:Key="ButtonGroupSolidSecondaryBorderBrush" ResourceKey="TextFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupSolidSecondaryPointeroverBorderBrush" ResourceKey="ControlFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupSolidSecondaryPressedBorderBrush" ResourceKey="TextFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupSolidTertiaryBorderBrush" ResourceKey="TextFillColorTertiary" />
    <StaticResource x:Key="ButtonGroupSolidTertiaryPointeroverBorderBrush" ResourceKey="ControlFillColorSecondary" />
    <StaticResource x:Key="ButtonGroupSolidTertiaryPressedBorderBrush" ResourceKey="TextFillColorTertiary" />
    <StaticResource x:Key="ButtonGroupSolidSuccessBorderBrush" ResourceKey="SystemFillColorSuccess" />
    <StaticResource x:Key="ButtonGroupSolidSuccessPointeroverBorderBrush" ResourceKey="SystemFillColorSuccess" />
    <StaticResource x:Key="ButtonGroupSolidSuccessPressedBorderBrush" ResourceKey="SystemFillColorSuccess" />
    <StaticResource x:Key="ButtonGroupSolidWarningBorderBrush" ResourceKey="SystemFillColorCaution" />
    <StaticResource x:Key="ButtonGroupSolidWarningPointeroverBorderBrush" ResourceKey="SystemFillColorCaution" />
    <StaticResource x:Key="ButtonGroupSolidWarningPressedBorderBrush" ResourceKey="SystemFillColorCaution" />
    <StaticResource x:Key="ButtonGroupSolidDangerBorderBrush" ResourceKey="SystemFillColorCritical" />
    <StaticResource x:Key="ButtonGroupSolidDangerPointeroverBorderBrush" ResourceKey="SystemFillColorCritical" />
    <StaticResource x:Key="ButtonGroupSolidDangerPressedBorderBrush" ResourceKey="SystemFillColorCritical" />
    <!--  end Solid  -->
</ResourceDictionary>
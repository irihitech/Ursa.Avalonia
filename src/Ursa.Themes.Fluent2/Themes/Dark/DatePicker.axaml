<ResourceDictionary x:ClassModifier="internal" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--CalendarDayButton-->
    <SolidColorBrush x:Key="CalendarDayBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CalendarDayBorderBrush" Color="Transparent" />
    <StaticResource x:Key="CalendarDayInRangeBackground" ResourceKey="SubtleFillColorSecondary" />
    <StaticResource x:Key="CalendarDayTodayBackground" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="CalendarDayTodayForeground" ResourceKey="TextOnAccentFillColorPrimary" />
    <StaticResource x:Key="CalendarDayNotCurrentMonthForeground" ResourceKey="TextFillColorTertiary" />
    <StaticResource x:Key="CalendarDayPointeroverBackground" ResourceKey="SubtleFillColorSecondary" />
    <StaticResource x:Key="CalendarDayPressedBackground" ResourceKey="SubtleFillColorTertiary" />
    <StaticResource x:Key="CalendarDaySelectedBackground" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="CalendarDaySelectedForeground" ResourceKey="TextOnAccentFillColorPrimary" />
    <StaticResource x:Key="CalendarDaySelectedPointeroverBackground" ResourceKey="AccentFillColorSecondaryBrush" />
    <StaticResource x:Key="CalendarDaySelectedPressedBackground" ResourceKey="AccentFillColorTertiaryBrush" />
    <StaticResource x:Key="CalendarDayInRangeForeground" ResourceKey="TextFillColorPrimary" />
    <StaticResource x:Key="CalendarDayStartEndDateBackground" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="CalendarDayStartEndDateBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="CalendarDayStartEndDatePointeroverBackground" ResourceKey="AccentFillColorSecondaryBrush" />
    <StaticResource x:Key="CalendarDayStartEndDatePressedBackground" ResourceKey="AccentFillColorTertiaryBrush" />
    <StaticResource x:Key="CalendarDayStartEndDateInRangeBackground" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="CalendarDayPreviewStartEndDateBackground" ResourceKey="ControlFillColorSecondary" />
    <StaticResource x:Key="CalendarDayPreviewStartEndDatePressedBackground" ResourceKey="ControlFillColorSecondary" />
    <StaticResource x:Key="CalendarDayBlackoutForeground" ResourceKey="TextFillColorDisabled" />
    <StaticResource x:Key="CalendarDayBlackoutBackground" ResourceKey="ControlFillColorDisabled" />
    <StaticResource x:Key="CalendarDayBlackoutTodayBackground" ResourceKey="AccentFillColorDisabled" />
    <!--CalendarYearButton-->
    <SolidColorBrush x:Key="CalendarYearBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CalendarYearBorderBrush" Color="Transparent" />
    <StaticResource x:Key="CalendarYearPointeroverBackground" ResourceKey="SubtleFillColorSecondary" />
    <StaticResource x:Key="CalendarYearPressedBackground" ResourceKey="SubtleFillColorTertiary" />
    <StaticResource x:Key="CalendarYearSelectedBackground" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="CalendarYearSelectedForeground" ResourceKey="TextOnAccentFillColorPrimary" />
    <StaticResource x:Key="CalendarYearSelectedPointeroverBackground" ResourceKey="AccentFillColorSecondaryBrush" />
    <!--CalendarView-->
</ResourceDictionary>
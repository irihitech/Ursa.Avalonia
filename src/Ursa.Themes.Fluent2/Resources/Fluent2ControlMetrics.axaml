  <CornerRadius x:Key="CalendarDatePickerCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="CalendarCornerRadius">8</CornerRadius>
  <Thickness x:Key="ThicknessCardPadding">16</Thickness>

  <CornerRadius x:Key="ComboBoxSelectorCornerRadius">4</CornerRadius>
  <Thickness x:Key="ComboBoxPopupBorderPadding">4</Thickness>
  <Thickness x:Key="ComboBoxPopupBorderThickness">1</Thickness>
  <CornerRadius x:Key="ComboBoxPopupBoxCornerRadius">8</CornerRadius>

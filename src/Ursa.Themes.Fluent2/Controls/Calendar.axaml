<ResourceDictionary x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa">
    <Design.PreviewWith>
        <ThemeVariantScope RequestedThemeVariant="Dark">
            <StackPanel Width="600" Height="400">
                <u:DatePicker HorizontalAlignment="Stretch" />
                <u:DateRangePicker />
            </StackPanel>
        </ThemeVariantScope>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type u:DatePickerCalendarDayButton}" TargetType="u:DatePickerCalendarDayButton">
        <Setter Property="MinWidth" Value="{DynamicResource CalendarDayMinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource CalendarDayMinHeight}" />
        <Setter Property="Margin" Value="{DynamicResource CalendarDayMargin}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource CalendarDayBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CalendarDayBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource CalendarDayBorderThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{DynamicResource CalendarDayCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="u:DatePickerCalendarDayButton">
                <Panel>
                    <Border
                        Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:in-range">
            <Setter Property="Background" Value="{DynamicResource CalendarDayInRangeBackground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CalendarDayInRangeCornerRadius}" />
            <Setter Property="BorderThickness" Value="{DynamicResource CalendarDayNoBorderThickness}" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarDayInRangeForeground}" />
        </Style>

        <Style Selector="^:today">
            <Setter Property="Background" Value="{DynamicResource CalendarDayTodayBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarDayTodayForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^:in-range">
                <Setter Property="Background" Value="{DynamicResource CalendarDayInRangeBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource CalendarDayInRangeForeground}" />
            </Style>
        </Style>

        <Style Selector="^:not-current-month">
            <Setter Property="Foreground" Value="{DynamicResource CalendarDayNotCurrentMonthForeground}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CalendarDayPointeroverBackground}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource CalendarDayPressedBackground}" />
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource CalendarDaySelectedBackground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CalendarDayCornerRadius}" />
            <Setter Property="BorderThickness" Value="{DynamicResource CalendarDayNoBorderThickness}" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarDaySelectedForeground}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource CalendarDaySelectedPointeroverBackground}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource CalendarDaySelectedPressedBackground}" />
            </Style>
        </Style>


        <Style Selector="^:start-date">
            <Setter Property="CornerRadius" Value="{DynamicResource CalendarDayStartDateCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource CalendarDayStartEndDateBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CalendarDayStartEndDateBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarDaySelectedForeground}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource CalendarDayStartEndDatePointeroverBackground}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource CalendarDayStartEndDatePressedBackground}" />
            </Style>
            <Style Selector="^:in-range">
                <Setter Property="BorderBrush" Value="{DynamicResource CalendarDayStartEndDateInRangeBackground}" />
                <Setter Property="BorderThickness" Value="{DynamicResource CalendarDayBorderThickness}" />
            </Style>
        </Style>

        <Style Selector="^:end-date">
            <Setter Property="CornerRadius" Value="{DynamicResource CalendarDayEndDateCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource CalendarDayStartEndDateBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CalendarDayStartEndDateBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarDaySelectedForeground}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource CalendarDayStartEndDatePointeroverBackground}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource CalendarDayStartEndDatePressedBackground}" />
            </Style>
            <Style Selector="^:in-range">
                <Setter Property="BorderBrush" Value="{DynamicResource CalendarDayStartEndDateInRangeBackground}" />
                <Setter Property="BorderThickness" Value="{DynamicResource CalendarDayBorderThickness}" />
            </Style>
        </Style>

        <Style Selector="^:preview-start-date">
            <Setter Property="CornerRadius" Value="{DynamicResource CalendarDayStartDateCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource CalendarDayPreviewStartEndDateBackground}" />
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource CalendarDayPreviewStartEndDatePressedBackground}" />
            </Style>
        </Style>

        <Style Selector="^:preview-end-date">
            <Setter Property="CornerRadius" Value="{DynamicResource CalendarDayEndDateCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource CalendarDayPreviewStartEndDateBackground}" />
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource CalendarDayPreviewStartEndDatePressedBackground}" />
            </Style>
        </Style>

        <Style Selector="^:blackout">
            <Setter Property="Foreground" Value="{DynamicResource CalendarDayBlackoutForeground}" />
            <Setter Property="Background" Value="{DynamicResource CalendarDayBlackoutBackground}" />
            <Setter Property="Cursor" Value="No" />
            <Style Selector="^:today">
                <Setter Property="Foreground" Value="{DynamicResource CalendarDayBlackoutTodayBackground}" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type u:DatePickerCalendarYearButton}" TargetType="u:DatePickerCalendarYearButton">
        <Setter Property="MinWidth" Value="{DynamicResource CalendarYearMinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource CalendarYearMinHeight}" />
        <Setter Property="Margin" Value="{DynamicResource CalendarYearMargin}" />
        <Setter Property="Background" Value="{DynamicResource CalendarYearBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CalendarYearBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource CalendarYearBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CalendarYearCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="u:DatePickerCalendarDayButton">
                <Panel>
                    <Border
                        Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CalendarYearPointeroverBackground}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource CalendarYearPressedBackground}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource CalendarYearSelectedBackground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CalendarYearCornerRadius}" />
            <Setter Property="BorderThickness" Value="{DynamicResource CalendarYearSelectedBorderThickness}" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarYearSelectedForeground}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource CalendarYearSelectedPointeroverBackground}" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type u:DatePickerCalendarView}" TargetType="u:DatePickerCalendarView">
        <Setter Property="MinHeight" Value="{DynamicResource CalendarViewMinWidth}" />
        <Setter Property="MinWidth" Value="{DynamicResource CalendarViewMinHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="u:DatePickerCalendarView">
                <Grid Background="{TemplateBinding Background}" RowDefinitions="Auto, *">
                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,16"
                        ColumnDefinitions="Auto, Auto,*, Auto, Auto">
                        <u:IconButton
                            Name="{x:Static u:DatePickerCalendarView.PART_FastPreviousButton}"
                            Grid.Column="0"
                            Icon="{DynamicResource CalendarItemFastPreviousIconGlyph}"
                            IconTemplate="{DynamicResource UrsaFluent2CalendarNavigationIconTemplate}"
                            Theme="{DynamicResource BorderlessIconButton}" />

                        <u:IconButton
                            Name="{x:Static u:DatePickerCalendarView.PART_PreviousButton}"
                            Grid.Column="1"
                            Icon="{DynamicResource CalendarItemPreviousIconGlyph}"
                            IconTemplate="{DynamicResource UrsaFluent2CalendarNavigationIconTemplate}"
                            Theme="{DynamicResource BorderlessIconButton}" />

                        <Grid Grid.Column="2" ColumnDefinitions="*, *">
                            <Button
                                Name="{x:Static u:DatePickerCalendarView.PART_YearButton}"
                                Grid.Column="0"
                                HorizontalContentAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Theme="{DynamicResource UrsaFluent2SubtleButton}" />
                            <Button
                                Name="{x:Static u:DatePickerCalendarView.PART_MonthButton}"
                                Grid.Column="1"
                                HorizontalContentAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Theme="{DynamicResource UrsaFluent2SubtleButton}" />
                            <Button
                                Name="{x:Static u:DatePickerCalendarView.PART_HeaderButton}"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Theme="{DynamicResource UrsaFluent2SubtleButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsVisible="True" />
                        </Grid>
                        <u:IconButton
                            Name="{x:Static u:DatePickerCalendarView.PART_NextButton}"
                            Grid.Column="3"
                            Icon="{DynamicResource CalendarItemNextIconGlyph}"
                            IconTemplate="{DynamicResource UrsaFluent2CalendarNavigationIconTemplate}"
                            Theme="{DynamicResource BorderlessIconButton}" />
                        <u:IconButton
                            Name="{x:Static u:DatePickerCalendarView.PART_FastNextButton}"
                            Grid.Column="4"
                            Icon="{DynamicResource CalendarItemFastNextIconGlyph}"
                            IconTemplate="{DynamicResource UrsaFluent2CalendarNavigationIconTemplate}"
                            Theme="{DynamicResource BorderlessIconButton}" />
                    </Grid>
                    <Grid
                        Name="{x:Static u:DatePickerCalendarView.PART_MonthGrid}"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ColumnDefinitions="*, *, *, *, *, *, *"
                        RowDefinitions="*, Auto, *, *, *, *, *, *" />
                    <Grid
                        Name="{x:Static u:DatePickerCalendarView.PART_YearGrid}"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ColumnDefinitions="*, *, *"
                        RowDefinitions="*, *, *, *" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    x:Class="Ursa.Themes.Semi.Locale.ja_jp"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="STRING_MENU_BRING_TO_FRONT">最前面へ移動</x:String>
    <x:String x:Key="STRING_MENU_BRING_FORWARD">前面へ移動</x:String>
    <x:String x:Key="STRING_MENU_SEND_BACKWARD">背面へ移動</x:String>
    <x:String x:Key="STRING_MENU_SEND_TO_BACK">最背面へ移動</x:String>
    <x:String x:Key="STRING_MENU_DIALOG_OK">OK</x:String>
    <x:String x:Key="STRING_MENU_DIALOG_CANCEL">キャンセル</x:String>
    <x:String x:Key="STRING_MENU_DIALOG_YES">はい</x:String>
    <x:String x:Key="STRING_MENU_DIALOG_NO">いいえ</x:String>
    <x:String x:Key="STRING_MENU_DIALOG_CLOSE">閉じる</x:String>
    <x:String x:Key="STRING_PAGINATION_JUMP_TO">指定ページへ移動</x:String>
    <x:String x:Key="STRING_PAGINATION_PAGE"> </x:String>
    <x:String x:Key="STRING_THEME_TOGGLE_DARK">ダーク</x:String>
    <x:String x:Key="STRING_THEME_TOGGLE_LIGHT">ライト</x:String>
    <x:String x:Key="STRING_THEME_TOGGLE_SYSTEM">システム</x:String>
    <x:String x:Key="STRING_DATE_TIME_CONFIRM">確定</x:String>
    <x:String x:Key="STRING_DATE_TIME_START_TIME">開始時刻</x:String>
    <x:String x:Key="STRING_DATE_TIME_END_TIME">終了時刻</x:String>
</ResourceDictionary>

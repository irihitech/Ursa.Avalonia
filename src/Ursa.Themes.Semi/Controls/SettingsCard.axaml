<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:iri="https://irihi.tech/shared">
    <Design.PreviewWith>
        <StackPanel Width="420" Margin="20" Spacing="16">
            <u:SettingsCardGroup Theme="{DynamicResource Test}" Header="Group" Description="Header and description above the card">
                <u:SettingsCard Icon="{DynamicResource SemiIconBell}" Content="Plain row" Description="with description" Note="Value" />
                <u:SettingsCard Icon="{DynamicResource SemiIconGithubLogo}" Content="Navigable row" ShowChevron="True" />
                <u:SettingsCard Icon="{DynamicResource SemiIconSemiLogo}" Content="Navigable row" ShowChevron="True" IsEnabled="False" />
                <u:SettingsCard Content="Expandable row" Description="click to expand" IsExpanded="True">
                    <u:SettingsCard.Detail>
                        <StackPanel Margin="52,16" Spacing="6">
                            <HyperlinkButton Content="Documentation" NavigateUri="https://docs.irihi.tech/ursa/" />
                            <HyperlinkButton Content="GitHub repository" NavigateUri="https://github.com/irihitech/Ursa.Avalonia" />
                            <HyperlinkButton Content="Semi Design" NavigateUri="https://semi.design" />
                        </StackPanel>
                    </u:SettingsCard.Detail>
                </u:SettingsCard>
                <u:SettingsCard Content="Expandable row" Description="click to expand" IsExpanded="True">
                    <u:SettingsCard.Detail>
                        <StackPanel>
                            <u:SettingsCard>
                                <CheckBox Content="Option A" IsChecked="True" />
                            </u:SettingsCard>
                            <u:SettingsCard>
                                <CheckBox Content="Option B" />
                            </u:SettingsCard>
                        </StackPanel>
                    </u:SettingsCard.Detail>
                </u:SettingsCard>
            </u:SettingsCardGroup>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type u:SettingsCardGroup}" TargetType="u:SettingsCardGroup">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource SemiSpacingExtraTight}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="u:SettingsCardGroup">
                <StackPanel Spacing="{DynamicResource SemiSpacingTight}">
                    <ContentPresenter
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        FontWeight="{DynamicResource SemiFontWeightBold}"
                        IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ContentPresenter
                        Content="{TemplateBinding Description}"
                        ContentTemplate="{TemplateBinding DescriptionTemplate}"
                        FontSize="12"
                        Foreground="{DynamicResource SemiColorText1}"
                        IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}"
                        TextWrapping="Wrap" />
                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type u:SettingsCard}" TargetType="u:SettingsCard">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusMedium}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="u:SettingsCard">
                <Border
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <StackPanel>
                        <Border
                            Name="PART_Root"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <ContentPresenter
                                    Name="PART_Icon"
                                    Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,16,0"
                                    Content="{TemplateBinding Icon}"
                                    ContentTemplate="{TemplateBinding IconTemplate}">
                                    <ContentPresenter.DataTemplates>
                                        <DataTemplate DataType="Geometry">
                                            <PathIcon
                                                Theme="{DynamicResource InnerPathIcon}"
                                                Classes="Large"
                                                Data="{Binding}" />
                                        </DataTemplate>
                                    </ContentPresenter.DataTemplates>
                                </ContentPresenter>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ContentPresenter
                                            Name="PART_Content"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Foreground="{DynamicResource SemiColorText0}"
                                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <ContentPresenter
                                            Name="PART_Trailing"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Trailing}"
                                            ContentTemplate="{TemplateBinding TrailingTemplate}"
                                            IsVisible="{TemplateBinding Trailing, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                    <ContentPresenter
                                        Name="PART_Description"
                                        Content="{TemplateBinding Description}"
                                        ContentTemplate="{TemplateBinding DescriptionTemplate}"
                                        FontSize="12"
                                        Foreground="{DynamicResource SemiColorText2}"
                                        IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <ContentPresenter
                                        Name="PART_Note"
                                        Content="{TemplateBinding Note}"
                                        ContentTemplate="{TemplateBinding NoteTemplate}"
                                        Foreground="{DynamicResource SemiColorText2}"
                                        IsVisible="{TemplateBinding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <ContentPresenter
                                        Name="PART_Right"
                                        Content="{TemplateBinding RightContent}"
                                        ContentTemplate="{TemplateBinding RightContentTemplate}"
                                        IsVisible="{TemplateBinding RightContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <PathIcon
                                        Name="PART_Chevron"
                                        Theme="{DynamicResource InnerPathIcon}"
                                        Data="{DynamicResource SemiIconChevronRight}"
                                        Foreground="{DynamicResource SemiColorText3}"
                                        IsVisible="False"
                                        RenderTransformOrigin="50%,50%">
                                        <PathIcon.Transitions>
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0.25" />
                                            </Transitions>
                                        </PathIcon.Transitions>
                                    </PathIcon>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ContentPresenter
                            Name="PART_DetailHost"
                            IsVisible="{TemplateBinding IsExpanded}"
                            Background="{TemplateBinding Background}"
                            BackgroundSizing="OuterBorderEdge"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Detail}"
                            ContentTemplate="{TemplateBinding DetailTemplate}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_DetailHost u|SettingsCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Style Selector="^:nth-child(1)">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Style>
        <Style Selector="^:expanded /template/ Border#PART_Root">
            <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={iri:CornerRadiusMixerConverter Top}}" />
        </Style>
        <Style Selector="^:expanded /template/ ContentPresenter#PART_DetailHost">
            <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={iri:CornerRadiusMixerConverter Bottom}}" />
        </Style>

        <Style Selector="^:interactive:pointerover:not(:over-detail) /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="^:interactive:pressed:not(:over-detail) /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="^[ShowChevron=True] /template/ PathIcon#PART_Chevron">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-detail /template/ PathIcon#PART_Chevron">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Data" Value="{DynamicResource SemiIconChevronDown}" />
        </Style>
        <Style Selector="^:has-detail:expanded /template/ PathIcon#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(-180deg)" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
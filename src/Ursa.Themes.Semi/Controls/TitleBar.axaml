<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa">
    <ControlTheme x:Key="{x:Type u:TitleBar}" TargetType="u:TitleBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="u:TitleBar">
                <Border
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    WindowDecorationProperties.ElementRole="TitleBar">
                    <!--  RightInset is driven onto this grid's right margin; oversized content is clipped  -->
                    <Grid
                        Name="PART_TitleBarGrid"
                        ClipToBounds="True"
                        ColumnDefinitions="Auto,*,Auto">
                        <ContentPresenter
                            Name="PART_LeftContentPresenter"
                            Grid.Column="0"
                            KeyboardNavigation.TabNavigation="Local"
                            WindowDecorationProperties.ElementRole="User"
                            Content="{TemplateBinding LeftContent}"
                            IsVisible="{Binding $self.Content,Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Grid.Column="1"
                            KeyboardNavigation.TabNavigation="Local"
                            WindowDecorationProperties.ElementRole="User"
                            Content="{TemplateBinding CenterContent}"
                            IsVisible="{Binding $self.Content,Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter
                            Name="PART_RightContentPresenter"
                            Grid.Column="2"
                            KeyboardNavigation.TabNavigation="Local"
                            WindowDecorationProperties.ElementRole="User"
                            Content="{TemplateBinding RightContent}"
                            IsVisible="{Binding $self.Content,Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>

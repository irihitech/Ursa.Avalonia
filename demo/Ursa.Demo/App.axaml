<Application
    x:Class="Ursa.Demo.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:iri="https://irihi.tech/shared"
    RequestedThemeVariant="Default"
    xmlns:vm="clr-namespace:Ursa.Demo.ViewModels"
    xmlns:aboutUsDemo="clr-namespace:Ursa.Demo.Pages.AboutUsDemo"
    x:DataType="vm:ApplicationViewModel">
    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />
        <semi:SemiPopupAnimations />
        <StyleInclude Source="avares://Irihi.Lingua.Core/Themes/Generic.axaml" />
        <StyleInclude Source="avares://Ursa.Demo/Themes/AnchorScrollViewer.axaml" />
        <StyleInclude Source="avares://Irihi.Dogma/CodeBlock/CodeBlock.axaml"/>
        <!--This style is created to demonstrate Dialog StyleClass feature. This style is applied to Dialog Window-->
        <Style Selector="u|StandardDialogWindow.Custom">
            <Style Selector="^ /template/ Button#PART_OKButton">
                <Setter Property="Content" Value="CUSTOM" />
                <Setter Property="iri:ClassHelper.Classes" Value="Warning" />
            </Style>
        </Style>
    </Application.Styles>
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem
                Header="About Us"
                Command="{Binding JumpToCommand}"
                CommandParameter="{x:Static aboutUsDemo:AboutUsDemoViewModel.Category_Key}" />
        </NativeMenu>
    </NativeMenu.Menu>
</Application>

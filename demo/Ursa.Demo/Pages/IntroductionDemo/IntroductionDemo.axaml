<UserControl
    x:Class="Ursa.Demo.Pages.IntroductionDemo.IntroductionDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Ursa.Demo.Pages.IntroductionDemo"
    xmlns:models="clr-namespace:Ursa.Demo.Models"
    x:DataType="vm:IntroductionDemoViewModel"
    d:DesignHeight="900"
    d:DesignWidth="1280"
    mc:Ignorable="d"
    xmlns:localizations="clr-namespace:Ursa.Demo.Localizations">
    <Design.DataContext>
        <vm:IntroductionDemoViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Cards -->
        <Style Selector="Border.ShowcaseCard">
            <Setter Property="Background"
                    Value="{DynamicResource SemiColorBgDefault}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BoxShadow"
                    Value="0 1 2 0 #16000000, 0 12 32 0 #14000000" />
        </Style>
        <Style Selector="Border.ShowcaseCard:pointerover">
            <Setter Property="BoxShadow"
                    Value="0 2 4 0 #16000000, 0 16 40 0 #1F000000" />
        </Style>

        <!-- Card typography -->
        <Style Selector="TextBlock.CardTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.CardSub">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.Caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Hero bits -->
        <Style Selector="Border.HeroChip">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderBrush"
                    Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="TextBlock.HeroChipText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#C7CDF4" />
        </Style>
        <Style Selector="TextBlock.HeroStatLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8C96C4" />
        </Style>
        <Style Selector="u|Marquee.HeroTicker TextBlock">
            <Setter Property="Foreground" Value="#A7B0D8" />
        </Style>
    </UserControl.Styles>

    <!--  Page root  -->
    <ScrollViewer Name="PageScroll"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="20">

            <!--  ============ Hero ============  -->
            <ThemeVariantScope RequestedThemeVariant="Dark" MaxHeight="360">
                <Border Name="HeroRoot" ClipToBounds="True"
                    CornerRadius="18"
                    HorizontalAlignment="Stretch">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%"
                            EndPoint="100%,100%">
                        <GradientStop Offset="0"
                                      Color="#0A0E24" />
                        <GradientStop Offset="0.45"
                                      Color="#141B4C" />
                        <GradientStop Offset="0.78"
                                      Color="#2A2070" />
                        <GradientStop Offset="1"
                                      Color="#45267F" />
                    </LinearGradientBrush>
                </Border.Background>
                <Panel>
                    <!--  glow orbs  -->
                    <Ellipse Width="520" Height="520"
                             Fill="#2E4CFF" Opacity="0.22"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="-190,-230,0,0">
                        <Ellipse.Effect>
                            <BlurEffect Radius="90" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="380" Height="380"
                             Fill="#7C3AED" Opacity="0.3"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,-130,-180">
                        <Ellipse.Effect>
                            <BlurEffect Radius="80" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="220" Height="220"
                             Fill="#22D3EE" Opacity="0.14"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,40,160,0">
                        <Ellipse.Effect>
                            <BlurEffect Radius="70" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <!--  rings  -->
                    <Ellipse Width="430" Height="430"
                             Stroke="#FFFFFF"
                             StrokeThickness="1"
                             Opacity="0.06"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,20,60,60" />
                    <Ellipse Width="640" Height="640"
                             Stroke="#FFFFFF"
                             StrokeThickness="1"
                             Opacity="0.04"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,20,-80,-80" />

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="14"
                                Margin="48,34,48,40">
                        <WrapPanel>
                            <Border Classes="HeroChip">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Ellipse Width="6"
                                            Height="6"
                                            Fill="#4ADE80" />
                                    <TextBlock
                                        Classes="HeroChipText"
                                        Text="MIT License" />
                                </StackPanel>
                            </Border>
                            <Border Classes="HeroChip"
                                    Margin="8,0,0,0">
                                <TextBlock
                                    Classes="HeroChipText"
                                    Text="Avalonia 12 · .NET 8+" />
                            </Border>
                            <Border Classes="HeroChip"
                                    Margin="8,0,0,0">
                                <TextBlock
                                    Classes="HeroChipText"
                                    Text="Cross Platform" />
                            </Border>
                        </WrapPanel>

                        <TextBlock FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="{Translate {x:Static localizations:LanguageManager+Keys.Main_Banner_Title}}" />

                        <TextBlock FontSize="14"
                                   Foreground="#B8C0E8"
                                   Text="{Translate {x:Static localizations:LanguageManager+Keys.Main_Banner_Description}}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12" Margin="0,6,0,0">
                            <Button Classes="Primary"
                                    Theme="{DynamicResource SolidButton}"
                                    Padding="24,0"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="docs"
                                    Content="Get Started" />
                            <u:IconButton
                                Classes="Tertiary"
                                Content="GitHub"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="github"
                                Icon="{StaticResource SemiIconGithubLogo}"
                                />
                        </StackPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <StackPanel Spacing="0">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <u:Int32Displayer
                                        Value="60"
                                        FontSize="24"
                                        Foreground="White" />
                                    <TextBlock Text="+"
                                            FontSize="24"
                                            Foreground="#8FB4FF" />
                                </StackPanel>
                                <TextBlock
                                    Classes="HeroStatLabel"
                                    Text="Controls" />
                            </StackPanel>
                            <StackPanel Spacing="0"
                                    Margin="28,0,0,0">
                                <TextBlock Text="6"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="White" />
                                <TextBlock
                                    Classes="HeroStatLabel"
                                    Text="Platforms" />
                            </StackPanel>
                            <StackPanel Spacing="0"
                                    Margin="28,0,0,0">
                                <TextBlock Text="100%"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="White" />
                                <TextBlock
                                    Classes="HeroStatLabel"
                                    Text="Open Source" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <!--  ticker  -->
                    <Border VerticalAlignment="Bottom"
                            Height="34"
                            Background="#10000000"
                            BorderBrush="#14FFFFFF"
                            BorderThickness="0,1,0,0">
                        <u:Marquee Classes="HeroTicker"
                                   Height="34" Speed="55"
                                   Content="◆ 60+ production-ready controls    ◆ Windows · macOS · Linux · Web · iOS · Android    ◆ MIT licensed, free forever    ◆ Dark mode &amp; theme palettes    ◆ 40+ languages built in    ◆ Powered by Avalonia 11" />
                    </Border>
                </Panel>
            </Border>
            </ThemeVariantScope>

            <!--  ============ Section header ============  -->
            <StackPanel Spacing="4" Margin="4,4,4,0">
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <Border Width="4" Height="18"
                            CornerRadius="2"
                            Background="{DynamicResource SemiColorPrimary}" />
                    <TextBlock FontSize="18"
                               Theme="{DynamicResource TitleTextBlock}"
                               Classes="H6"
                               Text="Control Showcase" />
                </StackPanel>
                <TextBlock Classes="Tertiary"
                           Margin="14,0,0,0"
                           Text="Live, interactive components — click, type, slide and explore." />
            </StackPanel>

            <!--  ============ Masonry ============  -->
            <Grid MinWidth="980"
                  ColumnDefinitions="*,16,*,16,*">

                <!--  ======== Column 1 ========  -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!--  Inputs  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="Inputs" />
                                <TextBlock
                                    Classes="CardSub"
                                    Text="TagInput · IPv4Box" />
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <u:TagInput Width="180"
                                        HorizontalAlignment="Left"
                                        PlaceholderText="Add a tag, press Enter"
                                        Tags="{Binding TagItems}" />
                                <u:IPv4Box Width="180"
                                        HorizontalAlignment="Left"
                                        IPAddress="{Binding IpAddress}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Selectors  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="Selectors" />
                                <TextBlock
                                    Classes="CardSub"
                                    Text="MultiComboBox · TreeComboBox · MultiAutoCompleteBox" />
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <u:MultiComboBox
                                    Width="280"
                                    HorizontalAlignment="Left"
                                    PlaceholderText="Favorite controls"
                                    ItemsSource="{Binding ComboBoxItems}" />
                                <u:TreeComboBox Width="280"
                                        HorizontalAlignment="Left"
                                        PlaceholderText="Namespace">
                                    <u:TreeComboBoxItem
                                        Header="Ursa">
                                        <u:TreeComboBoxItem
                                            Header="Controls">
                                            <u:TreeComboBoxItem
                                                Header="PinCode" />
                                            <u:TreeComboBoxItem
                                                Header="QRCode" />
                                        </u:TreeComboBoxItem>
                                        <u:TreeComboBoxItem
                                            Header="Themes" />
                                    </u:TreeComboBoxItem>
                                    <u:TreeComboBoxItem
                                        Header="Semi" />
                                </u:TreeComboBox>
                                <u:MultiAutoCompleteBox
                                    Width="280"
                                    HorizontalAlignment="Left"
                                    PlaceholderText="Search controls..."
                                    ItemsSource="{Binding AutoCompleteItems}"
                                    SelectedItems="{Binding AutoCompleteSelectedItems}">
                                    <u:MultiAutoCompleteBox.ItemTemplate>
                                        <DataTemplate
                                            DataType="models:ControlData">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock
                                                    Text="{Binding MenuHeader}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Opacity="0.5"
                                                    Text="{Binding Chinese}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </u:MultiAutoCompleteBox.ItemTemplate>
                                </u:MultiAutoCompleteBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!--  RangeSlider  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="RangeSlider" />
                                <TextBlock
                                    Classes="CardSub"
                                    Text="Dual-thumb range selection" />
                            </StackPanel>
                            <StackPanel Spacing="16"
                                    Margin="0,6,0,2">
                                <u:RangeSlider
                                    Maximum="100"
                                    LowerValue="{Binding LowerValue}"
                                    Minimum="0"
                                    UpperValue="{Binding UpperValue}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!--  Feedback & status  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="Feedback" />
                                <TextBlock
                                    Classes="CardSub"
                                    Text="Banner · Badge · Rating · Loading · DualBadge" />
                            </StackPanel>
                            <u:Banner
                                Classes="Bordered"
                                Content="Build #1024 passed all checks."
                                Header="Deployed"
                                Type="Success" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">
                                <u:Rating AllowHalf="True"
                                        Value="{Binding RatingValue}" />
                                <u:DualBadge Header="v">2.0</u:DualBadge>
                            </StackPanel>
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">
                                <ProgressBar Maximum="100"
                                        Value="72" />
                                <u:LoadingIcon
                                    Grid.Column="1"
                                    Classes="Small"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>


                </StackPanel>

                <!--  ======== Column 2 ========  -->
                <StackPanel Grid.Column="2" Spacing="16">
                    
                    <!--  QRCode  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="QRCode" />
                                <TextBlock
                                    Classes="CardSub"
                                    Text="Vector QR rendering with error correction" />
                            </StackPanel>
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="16">
                                <Border
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Padding="8"
                                    CornerRadius="10"
                                    Background="#0F000000"
                                    BorderBrush="{DynamicResource SemiColorBorder}"
                                    BorderThickness="1">
                                    <u:QRCode Width="112"
                                            Height="112"
                                            Background="Transparent"
                                            Data="https://github.com/irihitech/Ursa.Avalonia" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                    <u:DualBadge
                                        Header="GitHub">
                                        Ursa.Avalonia
                                    </u:DualBadge>
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.65"
                                        TextWrapping="Wrap"
                                        Text="Point your camera at the code to open the repository." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>


                    <!--  Security / PinCode  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="0">
                                <u:Avatar Classes="Blue"
                                        Content="IR" />
                                <u:Avatar Margin="-8,0,0,0"
                                        Classes="Green"
                                        Content="AV" />
                                <u:Avatar Margin="-8,0,0,0"
                                        Classes="Purple"
                                        Content="SM" />
                                <u:Avatar Margin="-8,0,0,0"
                                        Classes="Grey"
                                        Content="+4" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="Two-factor Authentication" />
                                <TextBlock FontSize="12"
                                        Opacity="0.6"
                                        TextWrapping="Wrap"
                                        Text="Enter the 6-digit code from your authenticator app to continue." />
                            </StackPanel>
                            <u:PinCode Count="6"
                                       HorizontalAlignment="Center"
                                       Mode="Digit"
                                       PasswordChar="•" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">
                                <HyperlinkButton
                                    Content="Resend code" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.55"
                                    Text="00:42" />
                            </StackPanel>
                            <Border Height="1"
                                    Background="{DynamicResource SemiColorBorder}"
                                    Opacity="0.6" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                Spacing="6">
                                <u:Int32Displayer
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SemiColorPrimary}"
                                    HorizontalAlignment="Center"
                                    Value="{Binding MetricValue}" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#16A34A"
                                        IsVisible="{Binding MetricIsUp}"
                                        Text="▲"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#DC2626"
                                        IsVisible="{Binding MetricIsDown}"
                                        Text="▼"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#16A34A"
                                        IsVisible="{Binding MetricIsUp}"
                                        Text="{Binding MetricDelta, StringFormat='+{0}'}" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#DC2626"
                                        IsVisible="{Binding MetricIsDown}"
                                        Text="{Binding MetricDelta, StringFormat='{}{0}'}" />
                                    <TextBlock
                                        Classes="CardSub"
                                        VerticalAlignment="Center"
                                        Text="requests / min" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Classes="CardSub"
                                       Text="PinCode · Avatar · Int32Displayer" />
                        </StackPanel>
                    </Border>
                    
                    <!--  Navigation  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="Navigation" />
                                <TextBlock
                                    Classes="CardSub"
                                    Text="Breadcrumb · ButtonGroup · Pagination" />
                            </StackPanel>
                            <u:Breadcrumb>
                                <u:BreadcrumbItem
                                    Content="Home"
                                    Icon="Home" />
                                <u:BreadcrumbItem
                                    Content="Components"
                                    Icon="Page" />
                                <u:BreadcrumbItem
                                    Content="Ursa"
                                    Icon="Page"
                                    IsReadOnly="True" />
                            </u:Breadcrumb>
                            <u:ButtonGroup
                                Classes="Primary Small"
                                ItemsSource="{Binding ButtonGroupItems}" />
                            <u:Pagination
                                HorizontalAlignment="Center"
                                TotalCount="86" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!--  ======== Column 3 ========  -->
                <StackPanel Grid.Column="4" Spacing="16">

                    <!--  Date & time  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="Date &amp; Time" />
                                <TextBlock
                                    Classes="CardSub"
                                    Text="DateTimePicker · DateRangePicker · TimeRangePicker" />
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <u:DateTimePicker
                                    Width="280"
                                    HorizontalAlignment="Left"
                                    SelectedDate="{Binding CurrentDateTime}" />
                                <u:DateRangePicker
                                    Width="280"
                                    HorizontalAlignment="Left"
                                    SelectedEndDate="{Binding EndDate}"
                                    SelectedStartDate="{Binding StartDate}" />
                                <u:TimeRangePicker
                                    Width="280"
                                    HorizontalAlignment="Left"
                                    SelectedEndTime="{Binding EndTime}"
                                    SelectedStartTime="{Binding StartTime}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Overlays  -->
                    <Border Classes="ShowcaseCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="Overlays" />
                                <TextBlock
                                    Classes="CardSub"
                                    Text="OverlayDialogHost · PopConfirm · IconButton" />
                            </StackPanel>
                            <Border Height="340"
                                    ClipToBounds="True"
                                    CornerRadius="12"
                                    Background="{DynamicResource SemiColorBackground1}"
                                    BorderBrush="{DynamicResource SemiGrey1}"
                                    BorderThickness="1">
                                <Panel>
                                    <TextBlock
                                        Margin="10,6,0,0"
                                        FontSize="10"
                                        Opacity="0.35"
                                        Text="OverlayDialogHost" />
                                    <u:OverlayDialogHost HostId="{x:Static vm:IntroductionDemoViewModel.LocalHost}" />
                                </Panel>
                            </Border>
                            <WrapPanel>
                                <Button
                                    Classes="Primary Small"
                                    Theme="{DynamicResource SolidButton}"
                                    Command="{Binding ShowDialogCommand}"
                                    Content="Show Dialog" />
                                <u:PopConfirm
                                    Margin="8,0,0,0"
                                    PopupContent="Artifacts will be removed permanently."
                                    PopupHeader="Delete this build?">
                                    <Button
                                        Classes="Danger Small"
                                        Theme="{DynamicResource OutlineButton}"
                                        Content="Uninstall" />
                                </u:PopConfirm>
                                <u:IconButton
                                    Margin="8,0,0,0"
                                    Icon="{StaticResource SemiIconCamera}" />
                                <u:IconButton
                                    Margin="8,0,0,0"
                                    Icon="{StaticResource SemiIconStar}"
                                    Classes="Warning" />
                                <u:IconButton
                                    Margin="8,0,0,0"
                                    Icon="{StaticResource SemiIconMore}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!--  Footer  -->
            <TextBlock HorizontalAlignment="Center"
                       FontSize="11" Opacity="0.5"
                       Text="Ursa is released under the MIT License · Built by IRIHI with Avalonia" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

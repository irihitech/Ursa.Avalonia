<UserControl
    x:Class="Ursa.Demo.Pages.TimePickerDemo.TimePickerDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Ursa.Demo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localizations="clr-namespace:Ursa.Demo.Localizations"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewModels="clr-namespace:Ursa.Demo.Pages.TimePickerDemo"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="viewModels:TimePickerDemoViewModel"
    mc:Ignorable="d">
    <TabControl>
        <TabItem
            Header="{Translate Key={x:Static localizations:LanguageManager+Keys.Tab_Header_Guide}}"
            Icon="{DynamicResource SemiIconBook}">
            <controls:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <controls:DemoSectionView SectionContext="{Binding BasicSection}">
                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                            <u:TimePicker />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding DisplayFormatSection}">
                        <DockPanel HorizontalSpacing="12">
                            <TextBox
                                Name="displayFormatBox"
                                DockPanel.Dock="Right"
                                Width="280"
                                InnerLeftContent="Display Format"
                                Text="HH:mm:ss" />
                            <u:TimePicker
                                Width="220"
                                DisplayFormat="{Binding #displayFormatBox.Text}"
                                SelectedTime="12:20:30" />
                        </DockPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding PanelFormatSection}">
                        <DockPanel HorizontalSpacing="12">
                            <TextBox
                                Name="panelFormatBox"
                                DockPanel.Dock="Right"
                                Width="280"
                                InnerLeftContent="Panel Format"
                                Text="tt HH mm ss" />
                            <u:TimePicker
                                Width="220"
                                DisplayFormat="HH:mm:ss"
                                PanelFormat="{Binding #panelFormatBox.Text}"
                                SelectedTime="12:20:30" />
                        </DockPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding UseWithBindingSection}">
                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                            <TextBlock Text="{Binding Time, StringFormat='Selected: {0}'}" />
                            <u:TimePicker
                                Width="220"
                                DisplayFormat="HH:mm:ss"
                                SelectedTime="{Binding Time, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding NeedConfirmationSection}">
                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                            <ToggleSwitch Name="needConfirmToggle" Content="Need Confirmation" />
                            <u:TimePicker
                                Width="220"
                                DisplayFormat="HH:mm:ss"
                                NeedConfirmation="{Binding #needConfirmToggle.IsChecked}"
                                SelectedTime="12:20:30" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding ReadonlyModeSection}">
                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                            <u:TimePicker
                                Width="220"
                                DisplayFormat="HH:mm:ss"
                                IsReadOnly="True"
                                SelectedTime="10:30:00" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding DataValidationSection}">
                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                            <TextBlock
                                Foreground="{DynamicResource TextBoxPlaceholderForeground}"
                                Text="Clear the time to trigger [Required] validation and see the error feedback." />
                            <u:TimePicker
                                Width="220"
                                Classes="ClearButton"
                                DisplayFormat="HH:mm:ss"
                                SelectedTime="{Binding ValidatedTime, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:DemoSectionView>
                </StackPanel>
            </controls:AnchorScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

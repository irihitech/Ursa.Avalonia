<UserControl
    x:Class="Ursa.Demo.Pages.KeyGestureInputDemo.KeyGestureInputDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Ursa.Demo.Controls"
    xmlns:localizations="clr-namespace:Ursa.Demo.Localizations"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="clr-namespace:Ursa.Demo.Pages.KeyGestureInputDemo;assembly=Ursa.Demo"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:KeyGestureInputDemoViewModel"
    mc:Ignorable="d">
    <TabControl>
        <TabItem Header="{Translate Key={x:Static localizations:LanguageManager+Keys.Tab_Header_Guide}}"
                 Icon="{DynamicResource SemiIconBook}">
            <controls:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <controls:DemoSectionView SectionContext="{Binding BasicUsageSection}">
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <u:KeyGestureInput
                                Width="300"
                                Gesture="Ctrl+Shift+A" />
                            <u:KeyGestureInput
                                Width="300"
                                InnerLeftContent="Left"
                                InnerRightContent="Right" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding AcceptableKeysSection}">
                        <u:KeyGestureInput
                            Width="300"
                            HorizontalAlignment="Center"
                            AcceptableKeys="{Binding AcceptableKeys}" />
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding ClearButtonStyleSection}">
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <u:KeyGestureInput
                                Width="300"
                                Gesture="Ctrl+Shift+A" />
                            <u:KeyGestureInput
                                Width="300"
                                AllowClear="False"
                                Gesture="Ctrl+Shift+A" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding StatesSection}">
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <u:KeyGestureInput
                                Width="300"
                                Gesture="Ctrl+Shift+A"
                                IsReadOnly="True" />
                            <u:KeyGestureInput
                                Width="300"
                                Gesture="Ctrl+K"
                                IsEnabled="False" />
                            <u:KeyGestureInput Width="300" />
                            <u:KeyGestureInput
                                Width="300"
                                Classes="Small"
                                Gesture="Ctrl+Shift+A" />
                            <u:KeyGestureInput
                                Width="300"
                                Classes="Large"
                                Gesture="Ctrl+Shift+A" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding ModifierBehaviorSection}">
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <u:KeyGestureInput
                                Width="300"
                                RequireModifier="True" />
                            <u:KeyGestureInput
                                Width="300"
                                ClearOnModifierRelease="False" />
                            <u:KeyGestureInput
                                Width="300"
                                Gesture="Ctrl+Shift+A" />
                        </StackPanel>
                    </controls:DemoSectionView>

                </StackPanel>
            </controls:AnchorScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Ursa.Demo.Controls"
             xmlns:localizations="clr-namespace:Ursa.Demo.Localizations"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="clr-namespace:Ursa.Demo.Pages.MultiAutoCompleteBoxDemo"
             xmlns:models="clr-namespace:Ursa.Demo.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:MultiAutoCompleteBoxDemoViewModel"
             x:Class="Ursa.Demo.Pages.MultiAutoCompleteBoxDemo.MultiAutoCompleteBoxDemo">
    <TabControl>
        <TabItem
            Header="{Translate Key={x:Static localizations:LanguageManager+Keys.Tab_Header_Guide}}"
            Icon="{DynamicResource SemiIconBook}">
            <controls:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <controls:DemoSectionView SectionContext="{Binding StringItemsSection}">
                        <u:MultiAutoCompleteBox
                            ItemsSource="{Binding StringItems}"
                            HorizontalAlignment="Left"
                            MaxWidth="400"
                            PlaceholderText="Select controls"
                            SelectedItems="{Binding SelectedStringItems}" />
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding CustomFilterAndTemplateSection}">
                        <u:MultiAutoCompleteBox
                            ItemsSource="{Binding Items}"
                            HorizontalAlignment="Left"
                            MaxWidth="400"
                            InnerLeftContent="Controls"
                            SelectedItems="{Binding SelectedItems}"
                            ItemFilter="{Binding FilterPredicate}"
                            FilterMode="Custom">
                            <u:MultiAutoCompleteBox.ItemTemplate>
                                <DataTemplate DataType="models:ControlData">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MenuHeader}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Chinese}" Classes="Secondary" FontSize="12" Margin="8 0 0 0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </u:MultiAutoCompleteBox.ItemTemplate>
                            <u:MultiAutoCompleteBox.SelectedItemTemplate>
                                <DataTemplate DataType="models:ControlData">
                                    <TextBlock Text="{Binding MenuHeader}" />
                                </DataTemplate>
                            </u:MultiAutoCompleteBox.SelectedItemTemplate>
                        </u:MultiAutoCompleteBox>
                    </controls:DemoSectionView>
                </StackPanel>
            </controls:AnchorScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

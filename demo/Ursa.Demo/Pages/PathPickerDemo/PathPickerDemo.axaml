<UserControl
    x:Class="Ursa.Demo.Pages.PathPickerDemo.PathPickerDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Ursa.Demo.Controls"
    xmlns:localizations="clr-namespace:Ursa.Demo.Localizations"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Ursa.Demo.Pages.PathPickerDemo"
    x:CompileBindings="True"
    x:DataType="vm:PathPickerDemoViewModel"
    mc:Ignorable="d">
    <TabControl>
        <TabItem
            Header="{Translate Key={x:Static localizations:LanguageManager+Keys.Tab_Header_Guide}}"
            Icon="{DynamicResource SemiIconBook}">
            <controls:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    Spacing="20">
                    <controls:DemoSectionView SectionContext="{Binding OpenFileSection}">
                        <u:PathPicker
                            Title="Select a file"
                            UsePickerType="OpenFile"
                            FileFilter="[Text,*.txt][JSON,*.json]" />
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding SaveFileSection}">
                        <u:PathPicker
                            Title="Save report"
                            UsePickerType="SaveFile"
                            SuggestedFileName="report"
                            DefaultFileExtension="json"
                            FileFilter="[JSON,*.json]" />
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding FolderSelectionSection}">
                        <u:PathPicker
                            Title="Select output folder"
                            UsePickerType="OpenFolder" />
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding MultipleSelectionSection}">
                        <StackPanel Spacing="12">
                            <u:PathPicker
                                Title="Select images"
                                UsePickerType="OpenFile"
                                AllowMultiple="True"
                                FileFilter="[Images,*.png,*.jpg,*.jpeg]"
                                SelectedPaths="{Binding SelectedFiles, Mode=OneWayToSource}" />
                            <ListBox
                                MaxHeight="160"
                                ItemsSource="{Binding SelectedFiles}" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding CommandSection}">
                        <StackPanel Spacing="12">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="16">
                                <u:PathPicker
                                    Title="Select a file"
                                    UsePickerType="OpenFile"
                                    IsOmitCommandOnCancel="True"
                                    Command="{Binding InspectStorageItemsCommand}" />
                                <u:PathPicker
                                    Title="Select a folder"
                                    UsePickerType="OpenFolder"
                                    IsOmitCommandOnCancel="True"
                                    Command="{Binding InspectStorageItemsCommand}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding SelectedItemInfo}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding CommandCancelSection}">
                        <StackPanel Spacing="12">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="16">
                                <ToggleSwitch
                                    Content="Omit command on cancel"
                                    IsChecked="{Binding IsOmitCommandOnCancel}" />
                                <ToggleSwitch
                                    Content="Clear selection on cancel"
                                    IsChecked="{Binding IsClearSelectionOnCancel}" />
                            </StackPanel>
                            <u:PathPicker
                                Title="Select files"
                                UsePickerType="OpenFile"
                                Command="{Binding SelectedCommand}"
                                IsOmitCommandOnCancel="{Binding IsOmitCommandOnCancel}"
                                IsClearSelectionOnCancel="{Binding IsClearSelectionOnCancel}" />
                            <TextBlock>
                                <Run Text="Command trigger count: " />
                                <Run Text="{Binding CommandTriggerCount}" />
                            </TextBlock>
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding AppearanceSection}">
                        <StackPanel Spacing="12">
                            <u:ClassSelector x:Name="classSelector">
                                <u:ClassSelectorGroup Header="Layout">
                                    <u:ClassSelectorItem ClassName="Top" />
                                </u:ClassSelectorGroup>
                            </u:ClassSelector>
                            <u:PathPicker
                                Title="Top layout"
                                u:ClassSelector.Source="{Binding #classSelector}" />
                            <u:PathPicker
                                Title="Button only"
                                Theme="{DynamicResource ButtonPathPicker}" />
                            <u:PathPicker
                                Title="Expandable list"
                                Theme="{DynamicResource ListPathPicker}"
                                AllowMultiple="True" />
                            <u:PathPicker Title="Custom button content">
                                <u:PathPicker.ButtonContent>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <PathIcon
                                            Data="{DynamicResource SemiIconSearch}"
                                            Height="16"
                                            Width="16"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="Browse"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </u:PathPicker.ButtonContent>
                            </u:PathPicker>
                        </StackPanel>
                    </controls:DemoSectionView>
                </StackPanel>
            </controls:AnchorScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

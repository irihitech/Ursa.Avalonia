<UserControl
    x:Class="Ursa.Demo.Pages.EnumSelectorDemo.EnumSelectorDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Ursa.Demo.Controls"
    xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
    xmlns:localizations="clr-namespace:Ursa.Demo.Localizations"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="clr-namespace:Ursa.Demo.Pages.EnumSelectorDemo;assembly=Ursa.Demo"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:EnumSelectorDemoViewModel"
    mc:Ignorable="d">
    <TabControl>
        <TabItem
            Header="{Translate Key={x:Static localizations:LanguageManager+Keys.Tab_Header_Guide}}"
            Icon="{DynamicResource SemiIconBook}">
            <controls:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <controls:DemoSectionView SectionContext="{Binding BasicSection}">
                        <StackPanel Spacing="12">
                            <u:EnumSelector
                                Width="200"
                                EnumType="{x:Type system:DayOfWeek}"
                                Value="{Binding Value}" />
                            <TextBlock Text="{Binding Value}" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding StylingSection}">
                        <DockPanel HorizontalSpacing="12">
                            <u:EnumSelector
                                Width="200"
                                Classes="Small"
                                EnumType="{x:Type system:DayOfWeek}"
                                Value="{Binding Value}" />
                        </DockPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding CustomEnumValuesSection}">
                        <StackPanel Spacing="12">
                            <u:EnumSelector
                                Width="200"
                                EnumType="{x:Type system:DayOfWeek}"
                                EnumValues="{Binding CustomEnumValues}"
                                Value="{Binding Value2}" />
                            <TextBlock Text="{Binding Value2}" />
                            <u:EnumSelector
                                Width="200"
                                EnumType="{x:Type system:DayOfWeek}"
                                Value="{Binding Value3}">
                                <u:EnumSelector.EnumValues>
                                    <generic:List x:TypeArguments="system:DayOfWeek">
                                        <system:DayOfWeek>Saturday</system:DayOfWeek>
                                        <system:DayOfWeek>Sunday</system:DayOfWeek>
                                        <system:DayOfWeek>Monday</system:DayOfWeek>
                                    </generic:List>
                                </u:EnumSelector.EnumValues>
                            </u:EnumSelector>
                            <TextBlock Text="{Binding Value3}" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding DescriptionAttributeSection}">
                        <StackPanel Spacing="12">
                            <u:EnumSelector
                                Width="220"
                                EnumType="{x:Type vm:DescriptionSampleEnum}"
                                DisplayDescription="True"
                                Value="{Binding DescriptionAttributeValue}" />
                            <TextBlock Text="{Binding DescriptionAttributeValue}" />
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding CustomDisplayNamesSection}">
                        <StackPanel Spacing="12">
                            <u:EnumSelector
                                Width="200"
                                EnumType="{x:Type system:DayOfWeek}"
                                DisplayDescription="True"
                                Value="{Binding Value3}">
                                <u:EnumSelector.EnumValues>
                                    <generic:List x:TypeArguments="u:EnumItemTuple">
                                        <u:EnumItemTuple Value="{x:Static system:DayOfWeek.Saturday}" DisplayName="星期六" />
                                        <u:EnumItemTuple Value="{x:Static system:DayOfWeek.Sunday}" DisplayName="星期日" />
                                        <u:EnumItemTuple Value="{x:Static system:DayOfWeek.Monday}" DisplayName="星期一" />
                                    </generic:List>
                                </u:EnumSelector.EnumValues>
                            </u:EnumSelector>
                            <TextBlock Text="{Binding Value3}" />
                        </StackPanel>
                    </controls:DemoSectionView>
                </StackPanel>
            </controls:AnchorScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

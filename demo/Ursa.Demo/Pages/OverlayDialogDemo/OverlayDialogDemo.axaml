<UserControl
    x:Class="Ursa.Demo.Pages.OverlayDialogDemo.OverlayDialogDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Ursa.Demo.Controls"
    xmlns:localizations="clr-namespace:Ursa.Demo.Localizations"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Ursa.Demo.Pages.OverlayDialogDemo"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:OverlayDialogDemoViewModel"
    mc:Ignorable="d">
    <TabControl>
        <TabItem Header="{Translate Key={x:Static localizations:LanguageManager+Keys.Tab_Header_Guide}}"
                 Icon="{DynamicResource SemiIconBook}">
            <controls:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <controls:DemoSectionView SectionContext="{Binding BasicUsageSection}">
                        <Button HorizontalAlignment="Left"
                                Command="{Binding StandardDialog.ShowDialogCommand}"
                                Content="Show overlay dialog" />
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding PositioningSection}">
                        <u:Form Width="320" LabelPosition="Top"
                                DataContext="{Binding Positioning}">
                            <u:EnumSelector u:FormItem.Label="Horizontal Anchor"
                                            EnumType="u:HorizontalPosition"
                                            Value="{Binding HorizontalAnchor}" />
                            <u:EnumSelector u:FormItem.Label="Vertical Anchor"
                                            EnumType="u:VerticalPosition"
                                            Value="{Binding VerticalAnchor}" />
                            <u:NumericDoubleUpDown u:FormItem.Label="Horizontal Offset"
                                                   Value="{Binding HorizontalOffset}" />
                            <u:NumericDoubleUpDown u:FormItem.Label="Vertical Offset"
                                                   Value="{Binding VerticalOffset}" />
                            <Button u:FormItem.NoLabel="True"
                                    Command="{Binding ShowDialogCommand}"
                                    Content="Show positioned dialog" />
                        </u:Form>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding LightDismissSection}">
                        <u:Form Width="320" LabelPosition="Top"
                                DataContext="{Binding LightDismiss}">
                            <CheckBox u:FormItem.Label="Can LightDismiss"
                                      IsChecked="{Binding CanLightDismiss}" />
                            <Button u:FormItem.NoLabel="True"
                                    Command="{Binding ShowDialogCommand}"
                                    Content="Show overlay dialog" />
                        </u:Form>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding LocalHostSection}">
                        <StackPanel Spacing="12">
                            <u:Form Width="320" LabelPosition="Top"
                                    DataContext="{Binding LocalHostDemo}">
                                <ToggleSwitch u:FormItem.Label="Overlay Host"
                                              IsChecked="{Binding UseLocalHost}"
                                              OffContent="Global" OnContent="Local" />
                                <Button u:FormItem.NoLabel="True"
                                        Command="{Binding ShowDialogCommand}"
                                        Content="Show overlay dialog" />
                            </u:Form>
                            <Border Height="280"
                                    Background="{DynamicResource SemiColorBackground1}"
                                    BorderBrush="{DynamicResource SemiGrey1}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="12">
                                <u:OverlayDialogHost HostId="{x:Static vm:OverlayDialogDemoViewModel.LocalHost}">
                                    <u:OverlayDialogHost.DialogDataTemplates>
                                        <DataTemplate DataType="x:String">
                                            <TextBlock Margin="24,24,48,24" Foreground="Red"
                                                       Text="{Binding Path=.}" />
                                        </DataTemplate>
                                    </u:OverlayDialogHost.DialogDataTemplates>
                                </u:OverlayDialogHost>
                            </Border>
                        </StackPanel>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding ModalitySection}">
                        <u:Form Width="320" LabelPosition="Top"
                                DataContext="{Binding Modality}">
                            <CheckBox u:FormItem.Label="Modal" IsChecked="{Binding IsModal}" />
                            <Button u:FormItem.NoLabel="True"
                                    Command="{Binding ShowDialogCommand}"
                                    Content="Show overlay dialog" />
                        </u:Form>
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding CustomContentSection}">
                        <Button HorizontalAlignment="Left"
                                Command="{Binding CustomDialog.ShowDialogCommand}"
                                Content="Show custom overlay dialog" />
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding StyleClassSection}">
                        <u:Form Width="320" LabelPosition="Top"
                                DataContext="{Binding Styling}">
                            <TextBox u:FormItem.Label="Style Class" Text="{Binding StyleClass}" />
                            <Button u:FormItem.NoLabel="True"
                                    Command="{Binding ShowDialogCommand}"
                                    Content="Show styled dialog" />
                        </u:Form>
                    </controls:DemoSectionView>
                </StackPanel>
            </controls:AnchorScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

<UserControl
    x:Class="Ursa.Demo.Pages.TagInputDemo.TagInputDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Ursa.Demo.Controls"
    xmlns:localizations="clr-namespace:Ursa.Demo.Localizations"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Ursa.Demo.Pages.TagInputDemo"
    x:DataType="vm:TagInputDemoViewModel"
    x:CompileBindings="True"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <TabControl>
        <TabItem
            Header="{Translate Key={x:Static localizations:LanguageManager+Keys.Tab_Header_Guide}}"
            Icon="{DynamicResource SemiIconBook}">
            <controls:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <controls:DemoSectionView SectionContext="{Binding BasicUsageSection}">
                        <u:TagInput
                            Width="420"
                            HorizontalAlignment="Left"
                            AllowDuplicates="True"
                            Separator="-"
                            PlaceholderText="Enter tags separated with -"
                            Tags="{Binding Tags}" />
                    </controls:DemoSectionView>

                    <controls:DemoSectionView SectionContext="{Binding DistinctAndMultilineSection}">
                        <StackPanel Spacing="12">
                            <u:TagInput
                                Width="420"
                                HorizontalAlignment="Left"
                                AllowDuplicates="False"
                                LostFocusBehavior="Clear"
                                Separator="-"
                                PlaceholderText="Duplicates are ignored"
                                Tags="{Binding DistinctTags}" />
                            <ListBox
                                Width="420"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding DistinctTags}" />
                            <u:TagInput
                                Width="420"
                                HorizontalAlignment="Left"
                                AllowDuplicates="False"
                                AcceptsReturn="True"
                                LostFocusBehavior="Clear"
                                Separator="-"
                                PlaceholderText="Accepts multiline paste"
                                Tags="{Binding DistinctTags}" />
                        </StackPanel>
                    </controls:DemoSectionView>
                </StackPanel>
            </controls:AnchorScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

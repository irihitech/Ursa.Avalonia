<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UseFluent2>true</UseFluent2>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\Ursa.Demo.Browser\Assets\Fonts\SourceHanSansCN-Regular.otf"
                      Link="Assets\Fonts\SourceHanSansCN-Regular.otf" />
    <AvaloniaResource Include="..\Ursa.Demo.Browser\Assets\Fonts\SourceHanSansCN-Bold.otf"
                      Link="Assets\Fonts\SourceHanSansCN-Bold.otf" />
    <None Update="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!--Restore is not per-configuration, so keep this reference unconditional; Release output strips it below.-->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <ProjectReference Include="../../src/Ursa.Themes.Fluent2/Ursa.Themes.Fluent2.csproj" />
  </ItemGroup>
  <Target Name="ExcludeDiagnosticsSupportFromRelease" AfterTargets="ResolvePackageAssets" Condition="'$(Configuration)' != 'Debug'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'AvaloniaUI.DiagnosticsSupport'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'AvaloniaUI.DiagnosticsSupport'" />
    </ItemGroup>
  </Target>
</Project>

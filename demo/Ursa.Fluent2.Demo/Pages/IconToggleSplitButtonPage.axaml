<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    x:Class="Ursa.Fluent2.Demo.Pages.IconToggleSplitButtonPage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="IconToggleSplitButton" FontWeight="SemiBold"/>
          <u:IconToggleSplitButton Name="IconToggleSplitButton" HorizontalAlignment="Left" MaxWidth="640" Content="Highlight" Icon="A">
            <u:IconToggleSplitButton.Flyout>
              <Flyout>
                <StackPanel Spacing="8">
                  <TextBlock Text="Highlight color" FontWeight="SemiBold"/>
                  <RadioButton Content="Yellow" GroupName="HighlightColor" IsChecked="True"/>
                  <RadioButton Content="Green" GroupName="HighlightColor"/>
                  <RadioButton Content="Blue" GroupName="HighlightColor"/>
                </StackPanel>
              </Flyout>
            </u:IconToggleSplitButton.Flyout>
          </u:IconToggleSplitButton>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>

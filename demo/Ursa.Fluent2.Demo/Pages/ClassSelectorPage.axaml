<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    x:Class="Ursa.Fluent2.Demo.Pages.ClassSelectorPage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="ClassSelector" FontWeight="SemiBold"/>
          <Button Name="ClassSelectorTarget" Content="Preview target"/>
          <u:ClassSelector Width="280" HorizontalAlignment="Left" Target="{Binding #ClassSelectorTarget}">
            <u:ClassSelectorGroup Header="Appearance">
              <u:ClassSelectorItem ClassName="accent" Content="Accent"/>
              <u:ClassSelectorItem ClassName="default" Content="Default"/>
            </u:ClassSelectorGroup>
          </u:ClassSelector>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>

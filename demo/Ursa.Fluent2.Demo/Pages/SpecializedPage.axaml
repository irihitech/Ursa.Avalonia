<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="https://irihi.tech/ursa" xmlns:sys="using:System" x:Class="Ursa.Fluent2.Demo.Pages.SpecializedPage">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="ImageViewer" FontSize="12" FontWeight="SemiBold"/>
          <u:ImageViewer HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Loading" FontSize="12" FontWeight="SemiBold"/>
          <u:Loading HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="MarkdownLine" FontSize="12" FontWeight="SemiBold"/>
          <u:MarkdownLine HorizontalAlignment="Left" MaxWidth="640" Text="Sample text"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Marquee" FontSize="12" FontWeight="SemiBold"/>
          <u:Marquee HorizontalAlignment="Left" MaxWidth="640" Content="Sample text"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="NumberDisplayer" FontSize="12" FontWeight="SemiBold"/>
          <u:Int32Displayer HorizontalAlignment="Left" MaxWidth="640" Value="3"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="QRCode" FontSize="12" FontWeight="SemiBold"/>
          <u:QRCode HorizontalAlignment="Left" Width="120" Height="120" Data="https://irihi.tech"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Rating" FontSize="12" FontWeight="SemiBold"/>
          <u:Rating HorizontalAlignment="Left" MaxWidth="640" Value="3"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Skeleton" FontSize="12" FontWeight="SemiBold"/>
          <u:Skeleton HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Shimmer text" FontSize="12" FontWeight="SemiBold"/>
          <u:ShimmerText Text="Loading content"/>
          <u:ShimmerSelectableText Text="Selectable loading content"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Timeline" FontSize="12" FontWeight="SemiBold"/>
          <u:Timeline>
            <u:TimelineItem Header="First item" Content="Item content"/>
            <u:TimelineItem Header="Second item" Content="Item content"/>
          </u:Timeline>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="LoadingContainer" FontSize="12" FontWeight="SemiBold"/>
          <u:LoadingContainer HorizontalAlignment="Left" MaxWidth="640" Content="Loading sample"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="LoadingIcon" FontSize="12" FontWeight="SemiBold"/>
          <u:LoadingIcon HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="RatingCharacter" FontSize="12" FontWeight="SemiBold"/>
          <u:RatingCharacter HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="TimelineItem" FontSize="12" FontWeight="SemiBold"/>
          <u:Timeline>
            <u:TimelineItem Header="Timeline item" Content="Item content"/>
          </u:Timeline>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

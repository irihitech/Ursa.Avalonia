<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    x:Class="Ursa.Fluent2.Demo.Pages.ResizerPage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Resizer" FontWeight="SemiBold"/>
          <u:WindowResizer HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="WindowResizerThumb" FontWeight="SemiBold"/>
          <u:WindowResizerThumb HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="DialogResizer" FontWeight="SemiBold"/>
          <u:DialogResizer HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="DialogResizerThumb" FontWeight="SemiBold"/>
          <u:DialogResizerThumb HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>

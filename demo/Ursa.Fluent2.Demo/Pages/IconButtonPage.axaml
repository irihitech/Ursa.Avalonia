<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    x:Class="Ursa.Fluent2.Demo.Pages.IconButtonPage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Buttons · visual comparison" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <StackPanel Spacing="8">
              <TextBlock Text="Avalonia Fluent 2" FontSize="12"/>
              <Button Content="Save changes"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Ursa Fluent 2" FontSize="12"/>
              <u:IconButton Content="Save changes"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="IconButton" FontWeight="SemiBold"/>
          <u:IconButton HorizontalAlignment="Left" MaxWidth="640" Content="Sample" Icon="A"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>

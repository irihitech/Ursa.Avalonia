<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    x:Class="Ursa.Fluent2.Demo.Pages.ScrollToButtonPage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="ScrollToButton" FontWeight="SemiBold"/>
          <Grid>
            <ScrollViewer x:Name="ScrollTarget" Width="280" Height="120">
              <StackPanel Spacing="8">
                <TextBlock Text="Scrollable item 1"/>
                <TextBlock Text="Scrollable item 2"/>
                <TextBlock Text="Scrollable item 3"/>
                <TextBlock Text="Scrollable item 4"/>
                <TextBlock Text="Scrollable item 5"/>
                <TextBlock Text="Scrollable item 6"/>
                <TextBlock Text="Scrollable item 7"/>
                <TextBlock Text="Scrollable item 8"/>
                <TextBlock Text="Scrollable item 9"/>
              </StackPanel>
            </ScrollViewer>
            <u:ScrollToButton Target="{Binding #ScrollTarget}" Direction="Bottom" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>

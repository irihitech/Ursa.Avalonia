<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="https://irihi.tech/ursa" xmlns:sys="using:System" x:Class="Ursa.Fluent2.Demo.Pages.InputsPage">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Text input · visual comparison" FontSize="12" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <StackPanel Spacing="8">
              <TextBlock Text="Avalonia Fluent 2" FontSize="12"/>
              <TextBox Text="Sample input" Width="240" Classes="clearButton"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Ursa Fluent 2" FontSize="12"/>
              <u:AutoCompleteBox Text="Sample input" Width="240"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="AutoCompleteBox" FontSize="12" FontWeight="SemiBold"/>
          <u:AutoCompleteBox HorizontalAlignment="Left" MaxWidth="640" Width="280" Text="Sample text" PlaceholderText="Enter a value"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="ControlClassesInput" FontSize="12" FontWeight="SemiBold"/>
          <u:ControlClassesInput HorizontalAlignment="Left" MaxWidth="640" Width="280"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="ClassSelector" FontSize="12" FontWeight="SemiBold"/>
          <Button Name="ClassSelectorTarget" Content="Preview target"/>
          <u:ClassSelector Width="280" HorizontalAlignment="Left" Target="{Binding #ClassSelectorTarget}">
            <u:ClassSelectorGroup Header="Appearance">
              <u:ClassSelectorItem ClassName="accent" Content="Accent"/>
              <u:ClassSelectorItem ClassName="default" Content="Default"/>
            </u:ClassSelectorGroup>
          </u:ClassSelector>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="EnumSelector" FontSize="12" FontWeight="SemiBold"/>
          <u:EnumSelector Width="280" HorizontalAlignment="Left" EnumType="{x:Type sys:DayOfWeek}" Value="{x:Static sys:DayOfWeek.Monday}"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Form" FontSize="12" FontWeight="SemiBold"/>
          <u:Form>
            <TextBox Width="240" Text="Alex Morgan" u:FormItem.Label="Name" u:FormItem.IsRequired="True"/>
            <TextBox Width="240" Text="alex@example.com" u:FormItem.Label="Email"/>
          </u:Form>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="IPv4Box" FontSize="12" FontWeight="SemiBold"/>
          <u:IPv4Box HorizontalAlignment="Left" MaxWidth="640" Width="280"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="KeyGestureInput" FontSize="12" FontWeight="SemiBold"/>
          <u:KeyGestureInput HorizontalAlignment="Left" MaxWidth="640" Width="280"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="MultiAutoCompleteBox" FontSize="12" FontWeight="SemiBold"/>
          <u:MultiAutoCompleteBox HorizontalAlignment="Left" MaxWidth="640" Width="280"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="MultiComboBox" FontSize="12" FontWeight="SemiBold"/>
          <u:MultiComboBox HorizontalAlignment="Left" MaxWidth="640" Width="280">
            <x:String>First item</x:String>
            <x:String>Second item</x:String>
          </u:MultiComboBox>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="NumericUpDown" FontSize="12" FontWeight="SemiBold"/>
          <NumericUpDown HorizontalAlignment="Left" MaxWidth="640" Width="280" Value="10" />
          <u:NumericIntUpDown HorizontalAlignment="Left" MaxWidth="640" Width="280" Value="3"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="NumPad" FontSize="12" FontWeight="SemiBold"/>
          <u:NumPad HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="PathPicker" FontSize="12" FontWeight="SemiBold"/>
          <u:PathPicker HorizontalAlignment="Left" MaxWidth="640" Width="280" ButtonContent="Select File"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="PinCode" FontSize="12" FontWeight="SemiBold"/>
          <u:PinCode HorizontalAlignment="Left" MaxWidth="640" Width="280"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="RangeSlider" FontSize="12" FontWeight="SemiBold"/>
          <u:RangeSlider Width="280" Minimum="0" Maximum="100" LowerValue="25" UpperValue="75"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="SelectionList" FontSize="12" FontWeight="SemiBold"/>
          <u:SelectionList HorizontalAlignment="Left" MaxWidth="640">
            <x:String>First item</x:String>
            <x:String>Second item</x:String>
          </u:SelectionList>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="TagInput" FontSize="12" FontWeight="SemiBold"/>
          <u:TagInput HorizontalAlignment="Left" MaxWidth="640" Width="280"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="TreeComboBox" FontSize="12" FontWeight="SemiBold"/>
          <u:TreeComboBox HorizontalAlignment="Left" MaxWidth="640" Width="280">
            <x:String>First item</x:String>
            <x:String>Second item</x:String>
          </u:TreeComboBox>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="ClosableTag" FontSize="12" FontWeight="SemiBold"/>
          <u:ClosableTag HorizontalAlignment="Left" MaxWidth="640" Content="Sample"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="FormGroup" FontSize="12" FontWeight="SemiBold"/>
          <u:FormGroup HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="FormItem" FontSize="12" FontWeight="SemiBold"/>
          <u:FormItem HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="MultiComboBoxItem" FontSize="12" FontWeight="SemiBold"/>
          <u:MultiComboBoxItem HorizontalAlignment="Left" MaxWidth="640" Content="Sample"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="MultiComboBoxSelectedItemList" FontSize="12" FontWeight="SemiBold"/>
          <u:MultiComboBoxSelectedItemList HorizontalAlignment="Left" MaxWidth="640">
            <x:String>First item</x:String>
            <x:String>Second item</x:String>
          </u:MultiComboBoxSelectedItemList>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="NumPadButton" FontSize="12" FontWeight="SemiBold"/>
          <u:NumPadButton HorizontalAlignment="Left" MaxWidth="640" Content="Sample"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="PinCodeCollection" FontSize="12" FontWeight="SemiBold"/>
          <u:PinCodeCollection HorizontalAlignment="Left" MaxWidth="640">
            <x:String>First item</x:String>
            <x:String>Second item</x:String>
          </u:PinCodeCollection>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="PinCodeItem" FontSize="12" FontWeight="SemiBold"/>
          <u:PinCodeItem HorizontalAlignment="Left" MaxWidth="640" Text="3"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="SelectionListItem" FontSize="12" FontWeight="SemiBold"/>
          <u:SelectionListItem HorizontalAlignment="Left" MaxWidth="640" Content="Sample"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="TreeComboBoxItem" FontSize="12" FontWeight="SemiBold"/>
          <u:TreeComboBoxItem HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

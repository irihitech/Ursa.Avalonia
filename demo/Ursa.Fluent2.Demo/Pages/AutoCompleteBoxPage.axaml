<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    xmlns:vm="using:Ursa.Fluent2.Demo.ViewModels"
    x:DataType="vm:AutoCompleteBoxPageViewModel"
    x:Class="Ursa.Fluent2.Demo.Pages.AutoCompleteBoxPage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Text input · visual comparison" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <StackPanel Spacing="8">
              <TextBlock Text="Avalonia Fluent 2" FontSize="12"/>
              <TextBox Text="Sample input" Width="240" Classes="clearButton"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Ursa Fluent 2" FontSize="12"/>
              <u:AutoCompleteBox Text="Sample input" Width="240"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="AutoCompleteBox" FontWeight="SemiBold"/>
          <TextBlock Text="Search the view-model collection and choose a city." TextWrapping="Wrap"/>
          <u:AutoCompleteBox Name="AutoCompleteInput" HorizontalAlignment="Left" MaxWidth="640" Width="280"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             FilterMode="Contains" PlaceholderText="Search cities"/>
          <TextBlock Name="SelectionValue" Text="{Binding SelectedItem, StringFormat='Selected: {0}', TargetNullValue='Selected: none'}"/>
          <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>

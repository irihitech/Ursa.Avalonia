<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="https://irihi.tech/ursa" xmlns:sys="using:System" x:Class="Ursa.Fluent2.Demo.Pages.OverlaysPage">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Banner" FontSize="12" FontWeight="SemiBold"/>
          <u:Banner HorizontalAlignment="Left" MaxWidth="640" Content="Sample"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Dialog" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Open window dialog sample" Tag="Dialog" Click="OpenSample" HorizontalAlignment="Left"/>
          <Button Content="Open modal overlay dialog sample" Tag="ModalDialog" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Drawer" FontSize="12" FontWeight="SemiBold"/>
          <u:StandardDrawerControl HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="MessageBox" FontSize="12" FontWeight="SemiBold"/>
          <u:MessageBoxControl HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Notification" FontSize="12" FontWeight="SemiBold"/>
          <u:NotificationCard HorizontalAlignment="Left" MaxWidth="640" Content="Sample notification"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="PopConfirm" FontSize="12" FontWeight="SemiBold"/>
          <u:PopConfirm HorizontalAlignment="Left" MaxWidth="640" Content="Confirm"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Toast" FontSize="12" FontWeight="SemiBold"/>
          <u:ToastCard HorizontalAlignment="Left" MaxWidth="640" Content="Sample toast"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="CustomDialogControl" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Open CustomDialogControl sample" Tag="CustomDialogControl" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="CustomDialogWindow" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Open CustomDialogWindow sample" Tag="CustomDialogWindow" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="CustomDrawerControl" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Open CustomDrawerControl sample" Tag="CustomDrawerControl" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="DialogResizer" FontSize="12" FontWeight="SemiBold"/>
          <u:DialogResizer HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="DialogResizerThumb" FontSize="12" FontWeight="SemiBold"/>
          <u:DialogResizerThumb HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="MessageBoxWindow" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Open MessageBoxWindow sample" Tag="MessageBoxWindow" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="OverlayDialogHost" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="OverlayDialogHost is active in the UrsaWindow demo host above."/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="StandardDialogControl" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Open StandardDialogControl sample" Tag="StandardDialogControl" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="StandardDialogWindow" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Open StandardDialogWindow sample" Tag="StandardDialogWindow" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Notification" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Show notification" Tag="WindowNotificationManager" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="12" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Toast" FontSize="12" FontWeight="SemiBold"/>
          <Button Content="Show toast" Tag="WindowToastManager" Click="OpenSample" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

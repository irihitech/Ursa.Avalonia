<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    x:Class="Ursa.Fluent2.Demo.Pages.DescriptionsPage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Descriptions" FontWeight="SemiBold"/>
          <u:Descriptions>
            <u:DescriptionsItem Label="Name" Content="Alex Morgan"/>
            <u:DescriptionsItem Label="Status" Content="Active"/>
          </u:Descriptions>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="DescriptionsItem" FontWeight="SemiBold"/>
          <u:Descriptions>
            <u:DescriptionsItem Label="Status" Content="Active"/>
          </u:Descriptions>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>

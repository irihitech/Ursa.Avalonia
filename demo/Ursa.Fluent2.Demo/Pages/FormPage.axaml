<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    x:Class="Ursa.Fluent2.Demo.Pages.FormPage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="Form" FontWeight="SemiBold"/>
          <u:Form>
            <TextBox Width="240" Text="Alex Morgan" u:FormItem.Label="Name" u:FormItem.IsRequired="True"/>
            <TextBox Width="240" Text="alex@example.com" u:FormItem.Label="Email"/>
          </u:Form>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="FormGroup" FontWeight="SemiBold"/>
          <u:FormGroup HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="FormItem" FontWeight="SemiBold"/>
          <u:FormItem HorizontalAlignment="Left" MaxWidth="640"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>

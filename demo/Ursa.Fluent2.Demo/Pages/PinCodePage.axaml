<pages:DemoPageView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:sys="using:System"
    xmlns:pages="using:Ursa.Fluent2.Demo.Pages"
    x:Class="Ursa.Fluent2.Demo.Pages.PinCodePage">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="PinCode" FontWeight="SemiBold"/>
          <u:PinCode HorizontalAlignment="Left" MaxWidth="640" Width="280"/>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="PinCodeCollection" FontWeight="SemiBold"/>
          <u:PinCodeCollection HorizontalAlignment="Left" MaxWidth="640">
            <x:String>First item</x:String>
            <x:String>Second item</x:String>
          </u:PinCodeCollection>
        </StackPanel>
      </Border>
      <Border Classes="gallery-card" Padding="24" CornerRadius="8" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Classes="gallery-label" Text="PinCodeItem" FontWeight="SemiBold"/>
          <u:PinCodeItem HorizontalAlignment="Left" MaxWidth="640" Text="3"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</pages:DemoPageView>
